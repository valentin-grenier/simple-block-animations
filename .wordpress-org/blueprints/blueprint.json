			"code": "<?php\nrequire_once '/wordpress/wp-load.php';\n// Runs as the admin so kses keeps the block markup intact.\nwp_set_current_user( 1 );\n$content = <<<'SIMPBLAN_DEMO'\n<!-- wp:group {\"align\":\"full\",\"style\":{\"dimensions\":{\"minHeight\":\"50vh\"},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|60\",\"bottom\":\"var:preset|spacing|60\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-3\",\"textColor\":\"base\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull has-base-color has-accent-3-background-color has-text-color has-background\" style=\"min-height:50vh;padding-top:var(--wp--preset--spacing--60);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--60);padding-left:var(--wp--preset--spacing--40)\"><!-- wp:heading {\"isAnimated\":true,\"animationType\":\"fade-in-up\"} -->\n<h2 class=\"wp-block-heading animate-fade-in-up\" style=\"--animation-duration:0.6s;--animation-delay:0s\">Scroll-triggered block animations</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"isAnimated\":true,\"animationType\":\"fade-in-up\",\"animationDelay\":0.2} -->\n<p class=\"animate-fade-in-up\" style=\"--animation-duration:0.6s;--animation-delay:0.2s\">The blocks on this page are core WordPress blocks animated with Simple Block Animations. Scroll down to see each animation play.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"isAnimated\":true,\"animationType\":\"fade-in-up\",\"animationDelay\":0.4} -->\n<div class=\"wp-block-buttons animate-fade-in-up\" style=\"--animation-duration:0.6s;--animation-delay:0.4s\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#animations\">See the animations</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#durations\">Compare durations</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"40vh\"} -->\n<div style=\"height:40vh\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:group {\"align\":\"wide\",\"layout\":{\"type\":\"default\"},\"anchor\":\"animations\"} -->\n<div class=\"wp-block-group alignwide\" id=\"animations\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">The animation types</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Each card plays the animation named on it.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":4,\"minimumColumnWidth\":\"14rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-3\",\"textColor\":\"base\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true} -->\n<div class=\"wp-block-group has-base-color has-accent-3-background-color has-text-color has-background animate-fade-in\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">fade-in</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fades in, without moving.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-1\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-up\",\"animationDelay\":0.1} -->\n<div class=\"wp-block-group has-contrast-color has-accent-1-background-color has-text-color has-background animate-fade-in-up\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0.1s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">fade-in-up</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fades in while moving up.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-2\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-down\",\"animationDelay\":0.2} -->\n<div class=\"wp-block-group has-contrast-color has-accent-2-background-color has-text-color has-background animate-fade-in-down\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0.2s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">fade-in-down</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fades in while moving down.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-3\",\"textColor\":\"base\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-left\",\"animationDelay\":0.3} -->\n<div class=\"wp-block-group has-base-color has-accen