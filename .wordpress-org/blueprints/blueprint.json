			"step": "runPHP",
			"code": "<?php\nrequire_once '/wordpress/wp-load.php';\n// Runs as the admin so kses keeps the block markup intact.\nwp_set_current_user( 1 );\n$content = <<<'SIMPBLAN_DEMO'\n<!-- wp:group {\"align\":\"full\",\"style\":{\"dimensions\":{\"minHeight\":\"50vh\"},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|60\",\"bottom\":\"var:preset|spacing|60\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-3\",\"textColor\":\"base\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull has-base-color has-accent-3-background-color has-text-color has-background\" style=\"min-height:50vh;padding-top:var(--wp--preset--spacing--60);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--60);padding-left:var(--wp--preset--spacing--40)\"><!-- wp:heading {\"isAnimated\":true,\"animationType\":\"fade-in-up\"} -->\n<h2 class=\"wp-block-heading animate-fade-in-up\" style=\"--animation-duration:0.6s;--animation-delay:0s\">Scroll-triggered block animations</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"isAnimated\":true,\"animationType\":\"fade-in-up\",\"animationDelay\":0.2} -->\n<p class=\"animate-fade-in-up\" style=\"--animation-duration:0.6s;--animation-delay:0.2s\">The blocks on this page are core WordPress blocks animated with Simple Block Animations. Scroll down to see each animation play.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"isAnimated\":true,\"animationType\":\"fade-in-up\",\"animationDelay\":0.4} -->\n<div class=\"wp-block-buttons animate-fade-in-up\" style=\"--animation-duration:0.6s;--animation-delay:0.4s\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#animations\">See the animations</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#durations\">Compare durations</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"40vh\"} -->\n<div style=\"height:40vh\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:group {\"align\":\"wide\",\"layout\":{\"type\":\"default\"},\"anchor\":\"animations\"} -->\n<div class=\"wp-block-group alignwide\" id=\"animations\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">The animation types</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Each card plays the animation named on it.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":4,\"minimumColumnWidth\":\"14rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-3\",\"textColor\":\"base\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true} -->\n<div class=\"wp-block-group has-base-color has-accent-3-background-color has-text-color has-background animate-fade-in\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">fade-in</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fades in, without moving.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-1\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-up\",\"animationDelay\":0.1} -->\n<div class=\"wp-block-group has-contrast-color has-accent-1-background-color has-text-color has-background animate-fade-in-up\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0.1s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">fade-in-up</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fades in while moving up.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-2\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-down\",\"animationDelay\":0.2} -->\n<div class=\"wp-block-group has-contrast-color has-accent-2-background-color has-text-color has-background animate-fade-in-down\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0.2s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">fade-in-down</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fades in while moving down.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-3\",\"textColor\":\"base\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-left\",\"animationDelay\":0.3} -->\n<div class=\"wp-block-group has-base-color has-accent-3-background-color has-text-color has-background animate-fade-in-left\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0.3s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">fade-in-left</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fades in from the left.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-1\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-right\",\"animationDelay\":0.4} -->\n<div class=\"wp-block-group has-contrast-color has-accent-1-background-color has-text-color has-background animate-fade-in-right\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0.4s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">fade-in-right</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fades in from the right.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-2\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"zoom-in\",\"animationDelay\":0.5} -->\n<div class=\"wp-block-group has-contrast-color has-accent-2-background-color has-text-color has-background animate-zoom-in\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0.5s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">zoom-in</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fades in while scaling up.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-3\",\"textColor\":\"base\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"slide-up\",\"animationDelay\":0.6} -->\n<div class=\"wp-block-group has-base-color has-accent-3-background-color has-text-color has-background animate-slide-up\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0.6s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">slide-up</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fades in while rising further.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"40vh\"} -->\n<div style=\"height:40vh\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:columns {\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}},\"dimensions\":{\"minHeight\":\"20rem\"}},\"backgroundColor\":\"accent-1\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-left\"} -->\n<div class=\"wp-block-group has-contrast-color has-accent-1-background-color has-text-color has-background animate-fade-in-left\" style=\"min-height:20rem;padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0s\"><!-- wp:paragraph -->\n<p>fade-in-left</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-right\",\"animationDelay\":0.2} -->\n<div class=\"wp-block-group animate-fade-in-right\" style=\"--animation-duration:0.6s;--animation-delay:0.2s\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Left and right</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The coloured block enters with fade-in-left. This text enters with fade-in-right, after a 0.2 s delay.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:spacer {\"height\":\"40vh\"} -->\n<div style=\"height:40vh\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:group {\"align\":\"wide\",\"layout\":{\"type\":\"default\"},\"anchor\":\"durations\"} -->\n<div class=\"wp-block-group alignwide\" id=\"durations\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Durations compared</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The same fade-in-up animation, at three durations.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":3,\"minimumColumnWidth\":\"12rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-2\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-up\",\"animationDuration\":0.3} -->\n<div class=\"wp-block-group has-contrast-color has-accent-2-background-color has-text-color has-background animate-fade-in-up\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.3s;--animation-delay:0s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">0.3 s</h3>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-2\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-up\",\"animationDuration\":0.8} -->\n<div class=\"wp-block-group has-contrast-color has-accent-2-background-color has-text-color has-background animate-fade-in-up\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.8s;--animation-delay:0s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">0.8 s</h3>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-2\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-up\",\"animationDuration\":1.6} -->\n<div class=\"wp-block-group has-contrast-color has-accent-2-background-color has-text-color has-background animate-fade-in-up\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:1.6s;--animation-delay:0s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">1.6 s</h3>\n<!-- /wp:heading --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\nSIMPBLAN_DEMO;\n$page_id = wp_insert_post(\n\tarray(\n\t\t'import_id'    => 1000,\n\t\t'post_type'    => 'page',\n\t\t'post_status'  => 'publish',\n\t\t'post_title'   => 'Animations demo',\n\t\t'post_content' => wp_slash( $content ),\n\t)\n);\nupdate_option( 'show_on_front', 'page' );\nupdate_option( 'page_on_front', $page_id );\n// Keeps the welcome modal from covering the guidance notice.\nglobal $wpdb;\nupdate_user_meta(\n\t1,\n\t$wpdb->get_blog_prefix() . 'persisted_preferences',\n\tarray(\n\t\t'core/edit-post' => array( 'welcomeGuide' => false ),\n\t\t'_modified'      => gmdate( 'c' ),\n\t)\n);\n"
