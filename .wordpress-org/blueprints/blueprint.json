			"data": "<?php\n/**\n * Guides Live Preview testers through the demo page in the editor.\n */\nadd_action(\n\t'enqueue_block_editor_assets',\n\tfunction () {\n\t\twp_add_inline_script(\n\t\t\t'wp-edit-post',\n\t\t\t<<<'JS'\nwp.domReady( function () {\n\tvar unsubscribe = wp.data.subscribe( function () {\n\t\tvar blocks = wp.data.select( 'core/block-editor' ).getBlocks();\n\t\tif ( ! wp.data.select( 'core/editor' ).__unstableIsEditorReady() || ! blocks.length ) {\n\t\t\treturn;\n\t\t}\n\t\tunsubscribe();\n\t\tif ( 1000 !== wp.data.select( 'core/editor' ).getCurrentPostId() ) {\n\t\t\treturn;\n\t\t}\n\t\tvar findAnimated = function ( list ) {\n\t\t\tfor ( var i = 0; i < list.length; i++ ) {\n\t\t\t\tvar found = list[ i ].attributes.isAnimated ? list[ i ] : findAnimated( list[ i ].innerBlocks );\n\t\t\t\tif ( found ) {\n\t\t\t\t\treturn found;\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn null;\n\t\t};\n\t\t// A selection made as the editor becomes ready gets dropped. Selecting also opens the Block tab.\n\t\tsetTimeout( function () {\n\t\t\twp.data.dispatch( 'core/block-editor' ).selectBlock( findAnimated( blocks ).clientId );\n\t\t}, 500 );\n\t\twp.data.dispatch( 'core/notices' ).createInfoNotice(\n\t\t\t'Try it: this block is already animated. Change its type, duration or delay in the Animations panel, click Save, then view the page. Animations only play there.',\n\t\t\t{\n\t\t\t\tid: 'simpblan-demo-guide',\n\t\t\t\tactions: [ { label: 'View the page', url: wp.data.select( 'core/editor' ).getPermalink() } ],\n\t\t\t}\n\t\t);\n\t} );\n} );\nJS\n\t\t);\n\t}\n);\n"
		},
