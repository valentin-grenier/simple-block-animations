padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0.5s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">zoom-in</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fades in while scaling up.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-3\",\"textColor\":\"base\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"slide-up\",\"animationDelay\":0.6} -->\n<div class=\"wp-block-group has-base-color has-accent-3-background-color has-text-color has-background animate-slide-up\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0.6s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">slide-up</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Fades in while rising further.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"40vh\"} -->\n<div style=\"height:40vh\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:columns {\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}},\"dimensions\":{\"minHeight\":\"20rem\"}},\"backgroundColor\":\"accent-1\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-left\"} -->\n<div class=\"wp-block-group has-contrast-color has-accent-1-background-color has-text-color has-background animate-fade-in-left\" style=\"min-height:20rem;padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.6s;--animation-delay:0s\"><!-- wp:paragraph -->\n<p>fade-in-left</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:group {\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-right\",\"animationDelay\":0.2} -->\n<div class=\"wp-block-group animate-fade-in-right\" style=\"--animation-duration:0.6s;--animation-delay:0.2s\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Left and right</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The coloured block enters with fade-in-left. This text enters with fade-in-right, after a 0.2 s delay.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:spacer {\"height\":\"40vh\"} -->\n<div style=\"height:40vh\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:group {\"align\":\"wide\",\"layout\":{\"type\":\"default\"},\"anchor\":\"durations\"} -->\n<div class=\"wp-block-group alignwide\" id=\"durations\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Durations compared</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The same fade-in-up animation, at three durations.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"layout\":{\"type\":\"grid\",\"columnCount\":3,\"minimumColumnWidth\":\"12rem\"}} -->\n<div class=\"wp-block-group\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-2\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-up\",\"animationDuration\":0.3} -->\n<div class=\"wp-block-group has-contrast-color has-accent-2-background-color has-text-color has-background animate-fade-in-up\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.3s;--animation-delay:0s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">0.3 s</h3>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-2\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-up\",\"animationDuration\":0.8} -->\n<div class=\"wp-block-group has-contrast-color has-accent-2-background-color has-text-color has-background animate-fade-in-up\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40);--animation-duration:0.8s;--animation-delay:0s\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">0.8 s</h3>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"accent-2\",\"textColor\":\"contrast\",\"layout\":{\"type\":\"constrained\"},\"isAnimated\":true,\"animationType\":\"fade-in-up\"